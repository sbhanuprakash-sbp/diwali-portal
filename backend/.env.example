# Copy this file to ".env" for LOCAL testing and fill in your own values.
# NEVER put real secrets in this example file, and never commit ".env".

# Local: SQLite. On Render the database address is filled in for you.
DATABASE_URL=sqlite:///diwali_dev.db

# REQUIRED, 32+ characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Exact frontend address(es), comma-separated, no trailing slash.
FRONTEND_ORIGIN=http://127.0.0.1:5500

ADMIN_USERNAME=choose-an-admin-username
# Generate:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YourLongAdminPassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=replace-with-the-bcrypt-hash

# Optional: also email every reply to you through Formspree.
FORMSPREE_URL=

# Optional: how many proxies sit in front of the app (Render = 1).
# If the admin dashboard shows the same IP for everyone, try 2.
TRUSTED_PROXIES=1
